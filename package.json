{
  "name": "@digitalfrontier/theme",
  "version": "1.0.0",
  "description": "Canonical Digital Frontier app theme — dark monochrome, cream accent. CSS tokens + shadcn-compatible aliases for Tailwind v4.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./theme.css",
  "style": "./theme.css",
  "exports": {
    ".": "./theme.css",
    "./theme.css": "./theme.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "df-theme-check": "./bin/df-theme-check.mjs"
  },
  "files": [
    "theme.css",
    "bin/df-theme-check.mjs",
    "README.md"
  ],
  "keywords": ["digital-frontier", "theme", "design-tokens", "tailwind"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Digital-Frontier-LDA/df-theme.git"
  },
  "peerDependencies": {
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": { "optional": true }
  }
}
